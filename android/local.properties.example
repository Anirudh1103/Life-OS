## This file was *NOT* generated by Android Studio
## Add it to .gitignore to avoid leaking your API keys
## Copy this to 'local.properties' and fill in your API keys

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# AI Provider API Keys (At least one required for JARVIS chat)
# Get Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Get Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Get OpenRouter API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ElevenLabs API Key (Optional, for premium JARVIS voice)
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

## IMPORTANT NOTES:
## 1. JARVIS chat requires at least ONE AI provider (Gemini, Groq, or OpenRouter)
## 2. If all AI providers are blank or invalid, chat will show an error
## 3. JARVIS will try providers in this order: Gemini → Groq → OpenRouter
## 4. Wake word detection works offline and doesn't require any API keys
## 5. ElevenLabs is optional - system TTS is used as fallback
