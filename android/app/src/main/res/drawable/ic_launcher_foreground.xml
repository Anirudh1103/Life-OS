<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
  <!-- Outer Rotating Glowing Ring -->
  <path
      android:pathData="M 50,50 m -32,0 a 32,32 0 1,1 64,0 a 32,32 0 1,1 -64,0"
      android:strokeWidth="6"
      android:fillColor="#00000000">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:startX="18"
          android:startY="18"
          android:endX="82"
          android:endY="82"
          android:type="linear">
        <item android:offset="0" android:color="#FF00F2FE"/>
        <item android:offset="1" android:color="#FFA855F7"/>
      </gradient>
    </aapt:attr>
  </path>
  <!-- Left Dot Eye (Violet) -->
  <path
      android:pathData="M 41,50 m -4.5,0 a 4.5,4.5 0 1,1 9,0 a 4.5,4.5 0 1,1 -9,0"
      android:fillColor="#FFA855F7"/>
  <!-- Right Dot Eye (Cyan) -->
  <path
      android:pathData="M 59,50 m -4.5,0 a 4.5,4.5 0 1,1 9,0 a 4.5,4.5 0 1,1 -9,0"
      android:fillColor="#FF00F2FE"/>
</vector>
